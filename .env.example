# Copy to .env.local and fill in. Anything prefixed VITE_ is bundled into the
# client and is PUBLIC. Do not put real secrets here.

# Placeholder gate for /admin, used ONLY when Supabase is not configured. NOT real security:
# it ships in the JS bundle. With Supabase configured, /admin uses Supabase Auth instead.
VITE_ADMIN_PASSWORD=change-me

# Optional MapLibre style URL. Leave blank for the default OSM raster tiles
# (fine for development; swap before real traffic, see OSM tile usage policy).
# Example: https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_URL=

# Supabase backend. With both set the app uses Supabase; with either blank it falls back to the
# bundled seed data and localStorage. Use the PUBLISHABLE (anon) key only: it is public by design
# and limited by Row Level Security. NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
