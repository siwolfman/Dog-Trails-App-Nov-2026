# Copy to .env.local and fill in. Anything prefixed VITE_ is bundled into the
# client and is PUBLIC. Do not put real secrets here.

# Placeholder gate for /admin while there is no backend. NOT real security:
# it ships in the JS bundle. Replace with Supabase Auth + RLS.
VITE_ADMIN_PASSWORD=change-me

# Optional MapLibre style URL. Leave blank for the default OSM raster tiles
# (fine for development; swap before real traffic, see OSM tile usage policy).
# Example: https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_URL=

# Reserved for the Supabase swap (unused in the front-end-only milestone)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
